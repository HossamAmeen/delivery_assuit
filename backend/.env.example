# Copy to .env and edit. Never commit .env.
# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite locally; PostgreSQL in staging/production)
DATABASE_URL=sqlite:///db.sqlite3

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# Pagination
API_PAGE_SIZE=20

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# HttpOnly refresh cookie. false on local HTTP; true behind HTTPS.
# Staging inherits the production default (true). Set false only if staging has no TLS yet.
REFRESH_COOKIE_SECURE=false

# Health API
HEALTH_CHECK_PASSWORD=change-me

# Celery / Redis: OFF in development; ON in staging only (config.settings.staging)
CELERY_ENABLED=False
CELERY_BEAT_ENABLED=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False
CELERY_WORKER_CONCURRENCY=2

# API rate limiting
# Trusted reverse proxies in front of Django: 0 = none (dev), 1 = one proxy such as Nginx.
# Never leave this unset behind a proxy, and must equal the real number of trusted proxy hops
# (never higher). Nginx must set X-Forwarded-For from $remote_addr and the backend port must
# not be reachable from outside (VULN-013).
NUM_PROXIES=0
RATELIMIT_ANON=60/minute
RATELIMIT_USER=300/minute
RATELIMIT_AUTH=10/minute
RATELIMIT_SENSITIVE=30/minute
RATELIMIT_HEALTH=120/minute
# Password recovery (per IP and per identifier)
RATELIMIT_RECOVERY=5/hour
RATELIMIT_RECOVERY_IDENTIFIER=5/hour
# Shared throttling cache (staging/production only)
RATELIMIT_CACHE_URL=redis://localhost:6379/2

# Admin login lockout: failures per IP / per username within the window (seconds)
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_MAX_ATTEMPTS_PER_USERNAME=30
ADMIN_LOGIN_WINDOW_SECONDS=900

# Deployment
DOMAIN=example.com
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_PATH=/opt/app/backend
FRONTEND_PATH=/opt/app/frontend
MEDIA_PATH=/opt/app/backend/media
STATIC_PATH=/opt/app/backend/static
SYSTEMD_SERVICE_NAME=app-backend

# First admin (used by `make create-admin`; set only when running it, never commit real values)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Demo data (used by `make seed-demo`; never use a real password)
DEMO_PASSWORD=

# OpenAPI docs endpoints (default: on; off in production)
# API_DOCS_ENABLED=True

# Password recovery email (TASK-048). Development prints mail to the console.
FRONTEND_ORIGIN=http://localhost:5173
PASSWORD_RESET_TIMEOUT_MINUTES=30
# Production: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Delivery <no-reply@localhost>
