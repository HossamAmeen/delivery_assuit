# Copy to .env (git-ignored) and edit. Never commit .env or real secrets.
# Used by docker-compose.yml (local development).

# --- Database (PostgreSQL container) ---
POSTGRES_DB=delivery
POSTGRES_USER=delivery
POSTGRES_PASSWORD=change-me-db

# --- Backend ---
SECRET_KEY=change-me-long-random-string
# Shared secret for the health endpoint. The frontend dev build sends it too (browser-visible).
HEALTH_CHECK_PASSWORD=change-me-health

# --- Published ports on your machine ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Optional: used only by `make docker-create-admin` / `make docker-seed` ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DEMO_PASSWORD=
